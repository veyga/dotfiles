#!/usr/bin/env bash
set -euo pipefail

dest="${1:?usage: cpgit <destination>}"
mkdir -p "$dest"

git rev-parse --git-dir >/dev/null 2>&1 || {
  echo "cpgit: not inside a git repository" >&2
  exit 1
}

while IFS= read -r -d '' file; do
  target="$dest/$file"
  mkdir -p "$(dirname "$target")"
  if [ -e "$file" ]; then
    cp -a "$file" "$target"
  else
    git show ":$file" > "$target"
  fi
done < <(git ls-files -z)
